{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "hinh_anh_3d/**",
      "use": "@vercel/static"
    },
    {
      "src": "am_thanh_cache/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/hinh_anh_3d/(.*)",
      "dest": "/hinh_anh_3d/$1"
    },
    {
      "src": "/am_thanh_cache/(.*)",
      "dest": "/am_thanh_cache/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
